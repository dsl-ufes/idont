@prefix idont: <https://purl.org/dsl/idont#>.
@prefix gufo: <http://purl.org/nemo/gufo#>.
@prefix dc: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://purl.org/dsl/idont> rdf:type owl:Ontology;
    owl:imports gufo:;
    dc:title "Information Disorder Ontology"@en;
    dcterms:language "en";
    rdfs:comment """Ontology for modeling information disorder phenomena, including disinformation, misinformation, malinformation, agents, participation, and bot-mediated interactions."""@en;
    vann:preferredNamespacePrefix "idont";
    vann:preferredNamespaceUri "https://purl.org/dsl/idont#"^^xsd:anyURI.
idont:Agent rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Agent"@en.
idont:MotivationType rdf:type owl:Class, gufo:AbstractIndividualType, owl:NamedIndividual;
    rdfs:subClassOf gufo:QualityValue;
    owl:equivalentClass [
  rdf:type owl:Class;
  owl:oneOf (idont:Political idont:Financial idont:Social idont:Psychological)
].
idont:Political rdf:type idont:MotivationType;
    rdfs:label "Political"@en.
idont:Financial rdf:type idont:MotivationType;
    rdfs:label "Financial"@en.
idont:Social rdf:type idont:MotivationType;
    rdfs:label "Social"@en.
idont:Psychological rdf:type idont:MotivationType;
    rdfs:label "Psychological"@en.
idont:MotivationType rdfs:label "MotivationType"@en.
idont:InformationDisorderEpisodePhase rdf:type owl:Class, gufo:EventType, owl:NamedIndividual;
    rdfs:subClassOf gufo:Event;
    rdfs:label "InformationDisorderEpisodePhase"@en.
idont:ParticipationType rdf:type owl:Class, gufo:AbstractIndividualType, owl:NamedIndividual;
    rdfs:subClassOf gufo:QualityValue;
    owl:equivalentClass [
  rdf:type owl:Class;
  owl:oneOf (idont:Creator idont:Producer idont:Distributor idont:Amplifier idont:Interpreter)
].
idont:Creator rdf:type idont:ParticipationType;
    rdfs:label "Creator"@en.
idont:Producer rdf:type idont:ParticipationType;
    rdfs:label "Producer"@en.
idont:Distributor rdf:type idont:ParticipationType;
    rdfs:label "Distributor"@en.
idont:Amplifier rdf:type idont:ParticipationType;
    rdfs:label "Amplifier"@en.
idont:Interpreter rdf:type idont:ParticipationType;
    rdfs:label "Interpreter"@en.
idont:ParticipationType rdfs:label "ParticipationType"@en.
idont:Motivation rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Quality;
    rdfs:label "Motivation"@en.
idont:InformationDisorderEvent rdf:type owl:Class, gufo:EventType, owl:NamedIndividual;
    rdfs:subClassOf gufo:Event;
    rdfs:label "InformationDisorderEvent"@en.
idont:DisinformationEvent rdf:type owl:Class, gufo:EventType, owl:NamedIndividual;
    rdfs:comment "Disinformation is false information that is deliberately created or disseminated with the express purpose to cause harm."@en;
    rdfs:label "DisinformationEvent"@en.
idont:MisinformationEvent rdf:type owl:Class, gufo:EventType, owl:NamedIndividual;
    rdfs:comment "Misinformation is information that is false, but not intended to cause harm."@en;
    rdfs:label "MisinformationEvent"@en.
idont:MalinformationEvent rdf:type owl:Class, gufo:EventType, owl:NamedIndividual;
    rdfs:comment "Malinformation is genuine information that is shared to cause harm."@en;
    rdfs:label "MalinformationEvent"@en.
idont:InformationDisorderEpisode rdf:type owl:Class, gufo:EventType, owl:NamedIndividual;
    rdfs:subClassOf gufo:Event;
    rdfs:label "InformationDisorderEpisode"@en.
idont:CreationPhase rdf:type owl:Class, gufo:EventType, owl:NamedIndividual;
    rdfs:label "CreationPhase"@en.
idont:ProductionPhase rdf:type owl:Class, gufo:EventType, owl:NamedIndividual;
    rdfs:label "ProductionPhase"@en.
idont:DistributionPhase rdf:type owl:Class, gufo:EventType, owl:NamedIndividual;
    rdfs:label "DistributionPhase"@en.
idont:AgentParticipation rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Relator;
    rdfs:label "AgentParticipation"@en.
idont:OfficialAgent rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "OfficialAgent"@en.
idont:UnofficialAgent rdf:type owl:Class, gufo:Role, owl:NamedIndividual;
    rdfs:label "UnofficialAgent"@en.
idont:Bot rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:comment """Bots are social media accounts that are operated entirely
by computer programs and are designed to generate posts
and/or engage with content on a particular platform.

In disinformation campaigns, bots can be used to draw
attention to misleading narratives, to hijack platforms'
trending lists, and to create the illusion of public discussion
and support."""@en;
    rdfs:label "Bot"@en.
idont:Message rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Message"@en.
idont:Organization rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Organization"@en.
idont:Person rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Person"@en.
idont:DisinformationEvent rdfs:subClassOf idont:InformationDisorderEvent.
idont:MisinformationEvent rdfs:subClassOf idont:InformationDisorderEvent.
idont:MalinformationEvent rdfs:subClassOf idont:InformationDisorderEvent.
idont:CreationPhase rdfs:subClassOf idont:InformationDisorderEpisodePhase.
idont:ProductionPhase rdfs:subClassOf idont:InformationDisorderEpisodePhase.
idont:DistributionPhase rdfs:subClassOf idont:InformationDisorderEpisodePhase.
idont:OfficialAgent rdfs:subClassOf idont:Agent.
idont:UnofficialAgent rdfs:subClassOf idont:Agent.
idont:Bot rdfs:subClassOf idont:Agent.
idont:Organization rdfs:subClassOf idont:Agent.
idont:Person rdfs:subClassOf idont:Agent.
idont:name_1 rdfs:domain idont:Agent;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "name"@en.
idont:startDate rdfs:domain idont:InformationDisorderEpisodePhase;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "startDate"@en.
idont:endDate rdfs:domain idont:InformationDisorderEpisodePhase;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "endDate"@en.
idont:motivationType rdfs:domain idont:Motivation;
    rdfs:range idont:MotivationType;
    rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf gufo:hasReifiedQualityValue;
    rdfs:label "motivationType"@en.
idont:descriptionText rdfs:domain idont:Motivation;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "descriptionText"@en.
idont:name rdfs:domain idont:InformationDisorderEpisode;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "name"@en.
idont:channel rdfs:domain idont:AgentParticipation;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "channel"@en.
idont:participationType rdfs:domain idont:AgentParticipation;
    rdfs:range idont:ParticipationType;
    rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf gufo:hasReifiedQualityValue;
    rdfs:label "participationType"@en.
idont:motivation rdfs:domain idont:AgentParticipation;
    rdfs:range idont:Motivation;
    rdf:type owl:ObjectProperty;
    rdfs:label "motivation"@en.
idont:intentionToHarm rdfs:domain idont:AgentParticipation;
    rdfs:range xsd:boolean;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "intentionToHarm"@en.
idont:content rdfs:domain idont:Message;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "content"@en.
idont:format rdfs:domain idont:Message;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "format"@en.
idont:basedOnReality rdfs:domain idont:Message;
    rdfs:range xsd:boolean;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "basedOnReality"@en.
idont:mediation rdf:type owl:ObjectProperty;
    rdfs:domain idont:AgentParticipation;
    rdfs:range idont:Agent;
    rdfs:label "mediation"@en.
idont:isMotivatedBy rdf:type owl:ObjectProperty;
    rdfs:domain idont:Motivation;
    rdfs:range idont:AgentParticipation;
    rdfs:label "isMotivatedBy"@en.
idont:partOf_1 rdf:type owl:ObjectProperty;
    rdfs:domain idont:InformationDisorderEpisode;
    rdfs:range idont:InformationDisorderEvent;
    rdfs:label "partOf"@en.
idont:partOf rdf:type owl:ObjectProperty;
    rdfs:domain idont:InformationDisorderEvent;
    rdfs:range idont:AgentParticipation;
    rdfs:label "partOf"@en.
idont:involves rdf:type owl:ObjectProperty;
    rdfs:domain idont:AgentParticipation;
    rdfs:range idont:Message;
    rdfs:label "involves"@en.
