PREFIX ex: <https://purl.org/dsl/idont/data/martian-invasion-cbs#>
PREFIX idont: <https://purl.org/dsl/idont#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# CQ1: How can an information disorder event be classified as misinformation, disinformation, or malinformation?

SELECT DISTINCT ?event ?class
WHERE {
  VALUES ?class { idont:MisinformationEvent idont:DisinformationEvent idont:MalinformationEvent }
  ?event rdf:type ?class .
}

# ---

# CQ2: Which agents participate in each phase of an information disorder episode?

SELECT DISTINCT ?phase ?agent
WHERE {
  ex:WarOfTheWorldsBroadcastEpisode idont:partOf_1 ?phase .
  ?phase rdf:type ?phaseType .
  VALUES ?phaseType { idont:CreationPhase idont:ProductionPhase idont:DistributionPhase }
  ?phase idont:partOf ?participation .
  ?participation idont:mediation ?agent .
}

# ---

# CQ3: Which content formats (e.g., text, audio, video) are associated with the message artifacts involved in each phase of the episode?

SELECT DISTINCT ?phase ?message ?format
WHERE {
  ex:WarOfTheWorldsBroadcastEpisode idont:partOf_1 ?phase .
  ?phase idont:partOf ?participation .
  ?participation idont:involves ?message .
  ?message rdf:type idont:Message ;
           idont:format ?format .
}

# ---

# CQ4: Which message artifact is reused across the phases of the episode?

SELECT DISTINCT ?phase ?message
WHERE {
  ex:WarOfTheWorldsBroadcastEpisode idont:partOf_1 ?phase .
  ?phase idont:partOf ?participation .
  ?participation idont:involves ?message .
}

# ---

# CQ5: What motivations characterize agents' participation in information disorder events?

SELECT DISTINCT ?agent ?motivation ?motivationType
WHERE {
  ex:WarOfTheWorldsBroadcastEpisode idont:partOf_1 ?phase .
  ?phase idont:partOf ?participation .
  ?participation idont:mediation ?agent ;
                 idont:motivation ?motivation .
  OPTIONAL { ?motivation idont:motivationType ?motivationType . }
}
