  <rdf:Description rdf:about="https://purl.org/dsl/idont">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="http://purl.org/nemo/gufo#"/>
    <dc:title xml:lang="en">Information Disorder Ontology</dc:title>
    <dcterms:language>en</dcterms:language>
    <rdfs:comment xml:lang="en">Ontology for modeling information disorder phenomena, including disinformation, misinformation, malinformation, agents, participation, and bot-mediated interactions.</rdfs:comment>
    <vann:preferredNamespacePrefix>idont</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://purl.org/dsl/idont#</vann:preferredNamespaceUri>
  </rdf:Description>
