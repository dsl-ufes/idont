  <rdf:Description rdf:about="https://purl.org/dsl/idont#Bot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Bots are social media accounts that are operated entirely
by computer programs and are designed to generate posts
and/or engage with content on a particular platform.

In disinformation campaigns, bots can be used to draw
attention to misleading narratives, to hijack platforms'
trending lists, and to create the illusion of public discussion
and support.</rdfs:comment>
    <rdfs:label xml:lang="en">Bot</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://purl.org/dsl/idont#Agent"/>
  </rdf:Description>
