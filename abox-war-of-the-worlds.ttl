@prefix ex: <https://purl.org/dsl/idont/data/martian-invasion-cbs#>.
@prefix idont: <https://purl.org/dsl/idont#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

ex:WarOfTheWorldsBroadcastEpisode rdf:type idont:InformationDisorderEpisode;
    idont:name "WarOfTheWorldsBroadcast";
    rdfs:label "War of the Worlds broadcast episode"@en;
    rdfs:comment "Case study based on the 1938 CBS broadcast of The War of the Worlds."@en;
    idont:partOf_1 ex:CreationPhase_MI, ex:ProductionPhase_MI, ex:DistributionPhase_MI.

ex:WarOfTheWorldsScript rdf:type idont:Message;
    rdfs:label "War of the Worlds broadcast script"@en;
    rdfs:comment "The fictional script prepared during the creation phase."@en;
    idont:content "Broadcast script for the fictional adaptation.";
    idont:format "text";
    idont:basedOnReality false.

ex:WarOfTheWorldsBroadcast rdf:type idont:Message, idont:MisinformationEvent;
    rdfs:label "War of the Worlds broadcast"@en;
    rdfs:comment "A live radio broadcast that simulated a realistic news report about a Martian invasion."@en;
    idont:content "Live radio broadcast simulating a realistic news report about a Martian invasion.";
    idont:format "audio";
    idont:basedOnReality false.

ex:OrsonWelles rdf:type idont:Person, idont:UnofficialAgent;
    rdfs:label "Orson Welles"@en.

ex:CBSRadio rdf:type idont:Organization, idont:OfficialAgent;
    rdfs:label "CBS Radio"@en.

ex:MercuryTheatreOnTheAir rdf:type idont:Organization, idont:OfficialAgent;
    rdfs:label "Mercury Theatre on the Air"@en.

ex:OrsonWellesMotivationSocial rdf:type idont:Motivation;
    rdfs:label "Orson Welles social motivation"@en;
    rdfs:comment "Social and collaborative storytelling associated with the fictional adaptation."@en;
    idont:descriptionText "Social and collaborative storytelling associated with the fictional adaptation.";
    idont:motivationType idont:Social.

ex:OrsonWellesMotivationPsychological rdf:type idont:Motivation;
    rdfs:label "Orson Welles psychological motivation"@en;
    rdfs:comment "Artistic and creative dramatic expression."@en;
    idont:descriptionText "Artistic and creative dramatic expression.";
    idont:motivationType idont:Psychological.

ex:CBSRadioMotivationFinancial rdf:type idont:Motivation;
    rdfs:label "CBS Radio financial motivation"@en;
    rdfs:comment "Financial and broadcasting objectives."@en;
    idont:descriptionText "Financial and broadcasting objectives.";
    idont:motivationType idont:Financial.

ex:CBSRadioMotivationSocial rdf:type idont:Motivation;
    rdfs:label "CBS Radio broadcasting motivation"@en;
    rdfs:comment "Broadcasting reach and public transmission objectives."@en;
    idont:descriptionText "Broadcasting reach and public transmission objectives.";
    idont:motivationType idont:Social.

ex:MercuryTheatreMotivationSocial rdf:type idont:Motivation;
    rdfs:label "Mercury Theatre social motivation"@en;
    rdfs:comment "Entertainment-oriented public engagement."@en;
    idont:descriptionText "Entertainment-oriented public engagement.";
    idont:motivationType idont:Social.

ex:MercuryTheatreMotivationPsychological rdf:type idont:Motivation;
    rdfs:label "Mercury Theatre entertainment motivation"@en;
    rdfs:comment "Entertainment-oriented motivation linked to the radio adaptation."@en;
    idont:descriptionText "Entertainment-oriented motivation linked to the radio adaptation.";
    idont:motivationType idont:Psychological.

ex:OrsonWellesParticipation rdf:type idont:AgentParticipation;
    rdfs:label "Orson Welles participation"@en;
    idont:mediation ex:OrsonWelles;
    idont:involves ex:WarOfTheWorldsScript;
    idont:participationType idont:Creator;
    idont:channel "radio";
    idont:intentionToHarm false;
    idont:motivation ex:OrsonWellesMotivationSocial, ex:OrsonWellesMotivationPsychological.

ex:CBSRadioParticipation rdf:type idont:AgentParticipation;
    rdfs:label "CBS Radio participation"@en;
    idont:mediation ex:CBSRadio;
    idont:involves ex:WarOfTheWorldsBroadcast;
    idont:participationType idont:Producer;
    idont:channel "radio";
    idont:intentionToHarm false;
    idont:motivation ex:CBSRadioMotivationFinancial, ex:CBSRadioMotivationSocial.

ex:MercuryTheatreOnTheAirParticipation rdf:type idont:AgentParticipation;
    rdfs:label "Mercury Theatre on the Air participation"@en;
    idont:mediation ex:MercuryTheatreOnTheAir;
    idont:involves ex:WarOfTheWorldsBroadcast;
    idont:participationType idont:Distributor;
    idont:channel "radio";
    idont:intentionToHarm false;
    idont:motivation ex:MercuryTheatreMotivationSocial, ex:MercuryTheatreMotivationPsychological.

ex:CreationPhase_MI rdf:type idont:CreationPhase;
    rdfs:label "Creation phase"@en;
    idont:partOf ex:OrsonWellesParticipation.

ex:ProductionPhase_MI rdf:type idont:ProductionPhase;
    rdfs:label "Production phase"@en;
    idont:partOf ex:CBSRadioParticipation.

ex:DistributionPhase_MI rdf:type idont:DistributionPhase;
    rdfs:label "Distribution phase"@en;
    idont:partOf ex:MercuryTheatreOnTheAirParticipation.
